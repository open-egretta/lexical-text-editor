{
  "name": "lexical-text-editor",
  "version": "0.0.1",
  "description": "Ready-to-use React rich text editor powered by Lexical",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
